# Settings read by the SSIS package and every script in etl/.
# Set them as Windows user environment variables, e.g. in PowerShell:
#   [Environment]::SetEnvironmentVariable("ENTSO_TOKEN", "<your token>", "User")
# (The scripts do not load a .env file by themselves; keep any real values out of git.)

# ENTSO-E Transparency Platform API token (https://transparency.entsoe.eu -> My Account -> Web API Security Token)
ENTSO_TOKEN=

# Optional ODBC connection string; if unset, scripts default to
# Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=EnergyWeatherDW;Trusted_Connection=yes;TrustServerCertificate=yes;
DW_CONNECTION_STRING=

# Optional ENTSO-E tuning (defaults in brackets). ENTSO-E allows 400 requests/minute per token and blocks
# the token for 10 minutes when exceeded, so keep the request rate well below that.
# ENTSOE_CHUNK_MONTHS=            months per request, 1-12 [3]
# ENTSOE_MAX_WORKERS=             parallel requests [12]
# ENTSOE_MAX_REQUESTS_PER_MINUTE= request rate limit [300]
